# Environment Configuration
# Copy this to .env and update values

# Database
DATABASE_URL=postgresql+asyncpg://transitops:transitops_secret@localhost:5432/transitops
DB_USER=transitops
DB_PASSWORD=transitops_secret

# Redis
REDIS_URL=redis://localhost:6379/0

# Security (CHANGE THIS IN PRODUCTION)
SECRET_KEY=generate-a-secure-random-string-minimum-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Application
LOG_LEVEL=INFO
MAX_PAGE_SIZE=100
RATE_LIMIT_PER_MINUTE=100
CACHE_TTL_SECONDS=300

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
API_URL=http://localhost:8000/api/v1
